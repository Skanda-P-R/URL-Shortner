# Server Configuration
PROJECT_NAME="URL Shortener"
DEBUG=false
BASE_URL="http://localhost:8000"

# ==============================================================================
# DATABASE CONFIGURATION
# ==============================================================================
# OPTION 1: Zero-Install Local Development (SQLite - works out of the box, no setup needed)
DATABASE_URL="sqlite+aiosqlite:///./urlshortener.db"

# OPTION 2: PostgreSQL (Docker or Cloud e.g. Neon.tech / Render / Supabase)
# DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/urlshortener"
# (For Neon: postgresql://<user>:<password>@ep-xyz.neon.tech/neondb?sslmode=require)

# ==============================================================================
# REDIS CACHE CONFIGURATION
# ==============================================================================
# If Redis is not running locally, the app automatically falls back to in-memory cache!
# Local Redis:
REDIS_URL="redis://localhost:6379/0"
# Cloud Redis (Upstash):
# REDIS_URL="rediss://default:<password>@cool-dog.upstash.io:6379"

# Cache TTL (in seconds) - Default: 24 hours (86400)
CACHE_TTL_SECONDS=86400

# CORS Allowed Origins
ALLOWED_ORIGINS="*"
